{
  "name": "@tio/oracle-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/generated/index.ts",
    "./attest": "./src/attest.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c ../../../.oxlintrc.json --type-aware --deny-warnings src/attest.ts src/attest.test.ts",
    "format": "oxfmt -c ../../../.oxfmtrc.json src/attest.ts src/attest.test.ts",
    "format:check": "oxfmt -c ../../../.oxfmtrc.json --check src/attest.ts src/attest.test.ts"
  },
  "dependencies": {
    "@solana/kit": "7.1.1",
    "@solana/program-client-core": "7.1.1"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.3.1",
    "@types/node": "24.19.0",
    "codama": "1.11.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
