# Context for gateway/Dockerfile (BuildKit reads <Dockerfile>.dockerignore).
# Only the lockfile, the gateway's sources, the oracle client sources,
# the deployment addresses and the default policy; never tests or keys.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!gateway/package.json
!gateway/src/
!clients/ts/oracle/package.json
!clients/ts/oracle/src/
!sandbox-bank/package.json
!sandbox-bank/src/crypto/jcs.ts
!packages/encoding/package.json
!packages/encoding/src/encoding.ts
!deployments/
!test-vectors/policy/default.json
gateway/src/**/*.test.ts
gateway/src/testing/
deployments/**/.rotate.lock
deployments/**/attestation-pending*.hex
deployments/**/*.tmp
deployments/**/*.lock
clients/ts/oracle/src/**/*.test.ts
