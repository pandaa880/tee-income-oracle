# ops runtime files under the committed deployments/ tree (enclave:rotate lock and
# per-attempt pending attestations, the deployment-file write lock and
# writeDeployment temp files). Archived
# attestation-<id>.hex files and <cluster>.json are committed.
deployments/**/.rotate.lock
deployments/**/attestation-pending*.hex
deployments/**/*.tmp
deployments/**/*.lock
