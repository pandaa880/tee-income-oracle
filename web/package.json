{
  "name": "@tio/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware --deny-warnings src",
    "format": "oxfmt -c ../.oxfmtrc.json src",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana-program/token": "0.15.0",
    "@solana/kit": "7.1.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tio/demo-pool-client": "workspace:*",
    "@tio/oracle-client": "workspace:*",
    "@tio/ui": "workspace:*",
    "eventsource-parser": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
