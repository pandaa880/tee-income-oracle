# Copy to .env (gitignored) and fill in. Never commit real values.

# Solana RPC — Helius (https://dashboard.helius.dev). Devnet for this project.
HELIUS_API_KEY=
HELIUS_NETWORK=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Program ids
SAS_PROGRAM_ID=22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG

# Admin ops (ops/): oracle program id + admin keypair path for `pnpm --filter @tio/ops sas:setup`.
# The keypair file is a secret; only its path goes here.
ORACLE_PROGRAM_ID=HZyMtqfwXMbqDUwWe9GVSvfZTaXaJZuKAMtJ1i6xwNG8
ADMIN_KEYPAIR=~/.config/solana/tee-income-oracle.json

# Sandbox bank (sandbox-bank/, FORMATS §15). Demo private keys as JSON text (secrets; locally
# `pnpm --filter @tio/sandbox-bank start:local` reads them from sandbox-bank/.secrets/ instead).
# Uses SOLANA_RPC_URL and ORACLE_PROGRAM_ID above.
SANDBOX_AA_PRIVATE_JWK=
SANDBOX_FIP_PRIVATE_JWK=
PORT=8081
# PINNED_DIR=enclave/pinned
# Shared gateway↔bank bearer token (FORMATS §15); set the same value on both when the
# bank has no private network. Unset = no caller check (local only). `openssl rand -hex 32`.
# BANK_TOKEN=

# Gateway (gateway/, FORMATS §16). Uses SOLANA_RPC_URL / SOLANA_WS_URL above. Its PORT
# defaults to 8082 (set PORT per process when running both services).
ENCLAVE_URL=http://127.0.0.1:8080
BANK_URL=http://127.0.0.1:8081
CLUSTER=devnet
# This enclave's registry id (oracle EnclaveEntry), set after registration.
MEASUREMENT_ID=
# POLICY_PATH=test-vectors/policy/default.json
# Relayer keypair as Solana CLI JSON text (a secret: pays the attestation fees).
RELAYER_KEYPAIR=
ALLOWED_ORIGIN=http://localhost:3000
# 1 behind one trusted proxy (Azure ingress): client IP = last X-Forwarded-For hop.
# TRUST_PROXY=1
